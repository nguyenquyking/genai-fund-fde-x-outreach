# Google Gemini API Key for live LLM DM generation
GEMINI_API_KEY=

# X API OAuth 1.0a User Context (for User Lookup, Tweets, DM Send & Reply Sync)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# X API OAuth 2.0 PKCE & User Context Tokens
X_USER_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Custom SQLite DB path
OUTREACH_DB_PATH=outreach_state.db
